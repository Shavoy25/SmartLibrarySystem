@model BorrowRecord
@{ ViewData["Title"]="Borrow/Return"; var records=ViewBag.Records as List<BorrowRecord> ?? new List<BorrowRecord>(); }
<section class="page-hero"><h1>Borrow or <span>Return Books</span></h1><p>This protected page records borrowing and return transactions in the shared database.</p></section><section class="container"><div class="panel"><h2>Borrow/Return Form</h2>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form asp-controller="BorrowReturn" asp-action="Index" method="post"><div class="form-row"><div class="form-group"><label>Record Code</label><input asp-for="RecordCode" placeholder="BR001" required/></div><div class="form-group"><label>Transaction Type</label><select asp-for="TransactionType" required><option value="">Select</option><option>Borrow</option><option>Return</option></select></div></div><div class="form-row"><div class="form-group"><label>Member ID</label><input asp-for="MemberID" type="number" required/></div><div class="form-group"><label>Book ID</label><input asp-for="BookID" type="number" required/></div></div><div class="form-row"><div class="form-group"><label>Borrow Date</label><input asp-for="BorrowDate" type="date"/></div><div class="form-group"><label>Due Date</label><input asp-for="DueDate" type="date"/></div></div><div class="form-row"><div class="form-group"><label>Return Date</label><input asp-for="ReturnDate" type="date"/></div><div class="form-group"><label>Status</label><select asp-for="Status" required><option value="">Select</option><option>Borrowed</option><option>Returned</option><option>Overdue</option></select></div></div><button type="submit" class="btn-primary">Save Transaction</button></form></div><div class="panel"><h2>Borrowing Records</h2><table><thead><tr><th>Record</th><th>Member</th><th>Book</th><th>Transaction</th><th>Due Date</th><th>Status</th></tr></thead><tbody>@if(records.Count==0){<tr><td colspan="6" class="empty-cell">No borrowing records yet.</td></tr>}else{foreach(var r in records){<tr><td>@r.RecordCode</td><td>@r.MemberName</td><td>@r.BookTitle</td><td>@r.TransactionType</td><td>@r.DueDate.ToString("yyyy-MM-dd")</td><td>@r.Status</td></tr>}}</tbody></table></div></section>
