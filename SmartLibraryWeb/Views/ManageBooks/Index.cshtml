@model Book
@{ ViewData["Title"]="Manage Books"; var books=ViewBag.Books as List<Book> ?? new List<Book>(); }
<section class="page-hero"><h1>Manage <span>Books</span></h1><p>Add, update, or delete books in the shared database.</p></section><section class="container"><div class="panel"><h2>Add New Book</h2>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form asp-controller="ManageBooks" asp-action="Index" method="post"><div class="form-row"><div class="form-group"><label>Book Code</label><input asp-for="BookCode" required/></div><div class="form-group"><label>Title</label><input asp-for="Title" required/></div></div><div class="form-row"><div class="form-group"><label>Author</label><input asp-for="Author" required/></div><div class="form-group"><label>Category</label><input asp-for="Category"/></div></div><div class="form-row"><div class="form-group"><label>ISBN</label><input asp-for="ISBN"/></div><div class="form-group"><label>Quantity</label><input asp-for="Quantity" type="number" required/></div></div><div class="form-group"><label>Status</label><select asp-for="Status" required><option value="">Select status</option><option>Available</option><option>Borrowed</option><option>Unavailable</option></select></div><button type="submit" class="btn-primary">Add Book</button></form></div><div class="panel"><h2>Books in Database</h2><table><thead><tr><th>Book ID</th><th>Book Code</th><th>Title</th><th>Author</th><th>Status</th><th>Actions</th></tr></thead><tbody>@if(books.Count==0){<tr><td colspan="6" class="empty-cell">No books have been added yet.</td></tr>}else{foreach(var b in books){<tr><td>@b.BookID</td><td>@b.BookCode</td><td>@b.Title</td><td>@b.Author</td><td>@b.Status</td><td><a asp-action="Edit" asp-route-id="@b.BookID" class="table-link">Edit</a><a asp-action="Delete" asp-route-id="@b.BookID" class="table-link danger">Delete</a></td></tr>}}</tbody></table></div></section>
