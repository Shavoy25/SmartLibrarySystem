@model Book
@{ ViewData["Title"]="Edit Book"; }
<section class="page-hero"><h1>Edit <span>Book</span></h1><p>Update book details in the shared database.</p></section><section class="container"><div class="panel"><form asp-controller="ManageBooks" asp-action="Edit" method="post"><input asp-for="BookID" type="hidden"/><div class="form-row"><div class="form-group"><label>Book Code</label><input asp-for="BookCode" required/></div><div class="form-group"><label>Title</label><input asp-for="Title" required/></div></div><div class="form-row"><div class="form-group"><label>Author</label><input asp-for="Author" required/></div><div class="form-group"><label>Category</label><input asp-for="Category"/></div></div><div class="form-row"><div class="form-group"><label>ISBN</label><input asp-for="ISBN"/></div><div class="form-group"><label>Quantity</label><input asp-for="Quantity" type="number" required/></div></div><div class="form-row"><div class="form-group"><label>Available Copies</label><input asp-for="AvailableCopies" type="number" required/></div><div class="form-group"><label>Status</label><select asp-for="Status" required><option>Available</option><option>Borrowed</option><option>Unavailable</option></select></div></div><button type="submit" class="btn-primary">Save Changes</button><a asp-controller="ManageBooks" asp-action="Index" class="btn-dark">Cancel</a></form></div></section>
