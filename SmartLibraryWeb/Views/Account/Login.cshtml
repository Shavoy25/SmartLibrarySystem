@model LoginViewModel
@{ ViewData["Title"]="Login"; }
<section class="auth-section"><div class="auth-container small"><h1>Library <span>Login</span></h1><p>Sign in to access protected library services.</p>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form asp-controller="Account" asp-action="Login" method="post"><div class="form-group"><label>Username</label><input asp-for="Username" required/></div><div class="form-group"><label>Password</label><input asp-for="Password" type="password" required/></div><button type="submit" class="btn-primary full">Login</button></form><p class="auth-link">Default librarian login: <strong>librarian / admin123</strong></p></div></section>
