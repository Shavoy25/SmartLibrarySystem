@{ string isLoggedIn = Context.Session.GetString("IsLoggedIn") ?? ""; }
<!DOCTYPE html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - Smart Library</title><link rel="stylesheet" href="~/css/site.css"/></head><body>
<header><div class="logo">Smart<span>Library</span></div><nav><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Catalog" asp-action="Index">Book Catalog</a><a asp-controller="Members" asp-action="Register">Registration</a><a asp-controller="BorrowReturn" asp-action="Index">Borrow/Return</a><a asp-controller="ManageBooks" asp-action="Index">Manage Books</a>@if(isLoggedIn=="true"){<a asp-controller="Account" asp-action="Logout">Logout</a>}else{<a asp-controller="Account" asp-action="Login">Login</a>}</nav></header>
@if(TempData["Message"]!=null){<div class="message">@TempData["Message"]</div>}<main>@RenderBody()</main><footer><p>&copy; 2026 Smart Library Management System. All Rights Reserved.</p></footer></body></html>
