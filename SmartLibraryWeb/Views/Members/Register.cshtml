@model Member
@{ ViewData["Title"]="Registration"; }
<section class="auth-section"><div class="auth-container"><h1>User <span>Registration</span></h1><p>Register a new library member and save the record to the shared database.</p>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<form asp-controller="Members" asp-action="Register" method="post"><div class="form-row"><div class="form-group"><label>Member ID</label><input asp-for="MemberCode" placeholder="Example: LIB001" required/></div><div class="form-group"><label>User Type</label><select asp-for="UserType" required><option value="">Select user type</option><option>Student</option><option>Teacher</option><option>Staff</option><option>Librarian</option></select></div></div><div class="form-row"><div class="form-group"><label>First Name</label><input asp-for="FirstName" required/></div><div class="form-group"><label>Last Name</label><input asp-for="LastName" required/></div></div><div class="form-row"><div class="form-group"><label>Email</label><input asp-for="Email" type="email"/></div><div class="form-group"><label>Phone</label><input asp-for="Phone"/></div></div><button type="submit" class="btn-primary full">Register User</button></form></div></section>
