@{ ViewData["Title"]="Home"; }
<section class="hero"><div class="hero-content"><h1>Welcome to the <span>Smart Library</span> Management System</h1><p>A modern ASP.NET Core web application for searching books, registering members, managing borrow/return records, and supporting library administration.</p><form class="search-box" asp-controller="Catalog" asp-action="Index" method="get"><input type="text" name="search" placeholder="Search for books, authors, categories, or ISBN..."/><button type="submit">Search</button></form><div class="hero-buttons"><a asp-controller="Catalog" asp-action="Index" class="btn-primary">Explore Catalog</a><a asp-controller="Members" asp-action="Register" class="btn-secondary">Register User</a></div></div></section>
<section class="section-title"><h2>Main Library Services</h2><p>Select an option below to access the main features of the system.</p></section><section class="cards-grid"><div class="card"><div class="icon">📚</div><h3>Book Catalog</h3><p>View books stored in the shared database.</p><a asp-controller="Catalog" asp-action="Index" class="btn-dark">View Catalog</a></div><div class="card"><div class="icon">📝</div><h3>User Registration</h3><p>Register library members.</p><a asp-controller="Members" asp-action="Register" class="btn-dark">Register</a></div><div class="card"><div class="icon">🔄</div><h3>Borrow or Return</h3><p>Record book borrowing and returns. Login is required.</p><a asp-controller="BorrowReturn" asp-action="Index" class="btn-dark">Borrow/Return</a></div><div class="card"><div class="icon">➕</div><h3>Add or Update Books</h3><p>Add, update, or delete books from the shared database.</p><a asp-controller="ManageBooks" asp-action="Index" class="btn-dark">Manage Books</a></div></section>
